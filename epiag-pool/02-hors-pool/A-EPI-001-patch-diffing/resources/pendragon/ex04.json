{
  "exercise": "A-EPI-001-patch-diffing/ex04",
  "title": "Écrire un finding",
  "difficulty": "hard",
  "points": 5,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex04/finding.md",
      "type": "file_exists",
      "file": "ex04/finding.md"
    },
    {
      "name": "ex04/finding.md has minimum length",
      "type": "custom",
      "command": "f=\"ex04/finding.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
