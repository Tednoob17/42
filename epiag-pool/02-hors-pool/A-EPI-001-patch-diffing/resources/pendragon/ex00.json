{
  "exercise": "A-EPI-001-patch-diffing/ex00",
  "title": "Archéologie de commit",
  "difficulty": "easy",
  "points": 3,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex00/commit-archaeology.md",
      "type": "file_exists",
      "file": "ex00/commit-archaeology.md"
    },
    {
      "name": "ex00/commit-archaeology.md has minimum length",
      "type": "custom",
      "command": "f=\"ex00/commit-archaeology.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
