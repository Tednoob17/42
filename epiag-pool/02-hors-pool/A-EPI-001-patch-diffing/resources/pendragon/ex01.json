{
  "exercise": "A-EPI-001-patch-diffing/ex01",
  "title": "Du diff à la root cause",
  "difficulty": "medium",
  "points": 5,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex01/root-cause.md",
      "type": "file_exists",
      "file": "ex01/root-cause.md"
    },
    {
      "name": "ex01/root-cause.md has minimum length",
      "type": "custom",
      "command": "f=\"ex01/root-cause.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
