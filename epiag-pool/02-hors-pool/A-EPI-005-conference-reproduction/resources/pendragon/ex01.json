{
  "exercise": "A-EPI-005-conference-reproduction/ex01",
  "title": "Reproduire le classifieur",
  "difficulty": "hard",
  "points": 5,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex01/repro.md",
      "type": "file_exists",
      "file": "ex01/repro.md"
    },
    {
      "name": "ex01/repro.md has minimum length",
      "type": "custom",
      "command": "f=\"ex01/repro.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    },
    {
      "name": "Directory exists: ex01/repro",
      "type": "custom",
      "command": "[ -d \"ex01/repro\" ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
