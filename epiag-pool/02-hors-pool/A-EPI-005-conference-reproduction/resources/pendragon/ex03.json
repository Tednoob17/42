{
  "exercise": "A-EPI-005-conference-reproduction/ex03",
  "title": "Talk et slides",
  "difficulty": "medium",
  "points": 4,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex03/talk.md",
      "type": "file_exists",
      "file": "ex03/talk.md"
    },
    {
      "name": "ex03/talk.md has minimum length",
      "type": "custom",
      "command": "f=\"ex03/talk.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    },
    {
      "name": "Directory exists: ex03/slides",
      "type": "custom",
      "command": "[ -d \"ex03/slides\" ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
