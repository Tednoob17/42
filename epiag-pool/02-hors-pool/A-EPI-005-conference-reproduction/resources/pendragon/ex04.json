{
  "exercise": "A-EPI-005-conference-reproduction/ex04",
  "title": "Q\\&A et fact-checking",
  "difficulty": "medium",
  "points": 4,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex04/qa.md",
      "type": "file_exists",
      "file": "ex04/qa.md"
