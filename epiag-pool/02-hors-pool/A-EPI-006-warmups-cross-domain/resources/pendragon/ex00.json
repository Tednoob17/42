{
  "exercise": "A-EPI-006-warmups-cross-domain/ex00",
  "title": "Node.js : le prédicat et le système",
  "difficulty": "medium",
  "points": 4,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex00/node-paths.md",
      "type": "file_exists",
      "file": "ex00/node-paths.md"
    },
    {
      "name": "ex00/node-paths.md has minimum length",
      "type": "custom",
      "command": "f=\"ex00/node-paths.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 160 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    },
    {
      "name": "File exists: ex00/path-model.js",
      "type": "file_exists",
      "file": "ex00/path-model.js"
    },
    {
      "name": "ex00/path-model.js does not open the filesystem",
      "type": "custom",
      "command": "f=\"ex00/path-model.js\"; ! grep -Eq \"require\\(['\\\"]fs['\\\"]\\)|require\\(['\\\"]child_process['\\\"]\\)\" \"$f\"",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
