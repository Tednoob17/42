{
  "exercise": "M-EPI-002-differential-audit-loop/ex01",
  "title": "Trouver les twins avec ctags",
  "difficulty": "medium",
  "points": 4,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex01/twins.md",
      "type": "file_exists",
      "file": "ex01/twins.md"
    },
    {
      "name": "ex01/twins.md has minimum length",
      "type": "custom",
      "command": "f=\"ex01/twins.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
