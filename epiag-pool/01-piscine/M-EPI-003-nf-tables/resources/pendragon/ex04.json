{
  "exercise": "M-EPI-003-nf-tables/ex04",
  "title": "Checklist de candidat",
  "difficulty": "hard",
  "points": 4,
  "timeout": 30,
  "tests": [
    {
      "name": "File exists: ex04/candidate.md",
      "type": "file_exists",
      "file": "ex04/candidate.md"
    },
    {
      "name": "ex04/candidate.md has minimum length",
      "type": "custom",
      "command": "f=\"ex04/candidate.md\"; [ -s \"$f\" ] || exit 1; [ \"$(wc -c < \"$f\")\" -gt 120 ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    },
    {
      "name": "Directory exists: ex04/queries",
      "type": "custom",
      "command": "[ -d \"ex04/queries\" ] || exit 1; echo OK",
      "expected_exit": 0,
      "timeout": 10
    }
  ]
}
